# Force client_max_body_size 500M après déploiement (évite 413)
container_commands:
  02_apply_upload_limit:
    command: |
      echo "client_max_body_size 500M;" | sudo tee /etc/nginx/conf.d/99_client_max_body_size.conf
      sudo nginx -t && sudo systemctl reload nginx || true
    ignoreErrors: true
