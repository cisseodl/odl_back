option_settings:
  aws:elasticbeanstalk:application:environment:
    # Base de données - À configurer avec vos valeurs RDS
    SPRING_DATASOURCE_URL: "jdbc:mysql://your-rds-endpoint:3306/odcawslearning?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&useUnicode=true&characterEncoding=UTF-8&connectTimeout=60000&socketTimeout=60000"
    SPRING_DATASOURCE_USERNAME: "root"
    SPRING_DATASOURCE_PASSWORD: "your-password"
    
    # AWS S3 Configuration
    AWS_ACCESS_KEY: "your-access-key"
    AWS_SECRET_KEY: "your-secret-key"
    AWS_REGION: "us-east-1"
    AWS_BUCKET_NAME: "odc-learning-bucket"
    
    # Server Configuration
    SERVER_PORT: "5000"
    SERVER_SERVLET_CONTEXT_PATH: "/awsodclearning"
    
    # Spring Profile
    SPRING_PROFILES_ACTIVE: "production"
    
    # JWT Token
    TOKEN_SIGNING_KEY: "413F4428472B4B62506hdfgamooATK979244226452948404D6351"
    
    # File Upload
    FILE_UPLOAD_DIR: "/var/app/current/uploads"
