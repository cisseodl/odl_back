files:
  "/etc/nginx/conf.d/proxy.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      client_max_body_size 500M;
      proxy_connect_timeout 600;
      proxy_send_timeout 600;
      proxy_read_timeout 600;
      send_timeout 600;
      proxy_request_buffering off;
container_commands:
  01_reload_nginx:
    command: "sudo systemctl reload nginx 2>/dev/null || sudo service nginx reload 2>/dev/null || true"
