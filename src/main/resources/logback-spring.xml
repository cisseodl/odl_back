<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    
    <!-- Console Appender pour Elastic Beanstalk -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    
    <!-- Logs spécifiques pour l'inscription aux cours -->
    <logger name="com.odc.aws_learning.app.service.CourseService" level="DEBUG"/>
    
    <!-- Logs pour les transactions -->
    <logger name="org.springframework.transaction" level="DEBUG"/>
    <logger name="org.springframework.orm.jpa" level="DEBUG"/>
    
    <!-- Logs pour les erreurs -->
    <logger name="org.springframework" level="INFO"/>
    <logger name="com.odc.aws_learning" level="DEBUG"/>
    
    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
